# ══════════════════════════════════════════════════
# Argus — Environment Configuration
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════

# ── LLM ──────────────────────────────────────────
LLM_MODEL_NAME=Qwen/Qwen3-14B
LLM_FALLBACK_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# ── PostgreSQL — structured data ─────────────────
# Stores: FIR findings, case sessions, audit logs,
# agent outputs, confidence scores, custody records
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=argus
POSTGRES_USER=argus_user
POSTGRES_PASSWORD=argus_dev
POSTGRES_URL=postgresql://argus_user:argus_dev@localhost:5433/argus

# ── MinIO — raw evidence object storage ──────────
# Stores: original evidence files (immutable blobs)
# memory dumps, PCAP files, disk images, etc.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=argus_minio
MINIO_SECRET_KEY=argus_minio_dev
MINIO_SECURE=false
# Buckets (auto-created on startup)
MINIO_BUCKET_RAW_EVIDENCE=argus-raw-evidence
MINIO_BUCKET_ENCRYPTED=argus-encrypted-evidence

# ── Neo4j — graph database ────────────────────────
# Used by Agent 2 (correlation) and Agent 3 (kill-chain)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus_dev

# ── Qdrant — vector database ──────────────────────
# Used by Agent 5b (RAG — Validated Case Repository)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Threat Intel Feeds ────────────────────────────
TAXII_SERVER_URL=
TAXII_API_KEY=
NVD_API_KEY=
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ── Security ──────────────────────────────────────
EVIDENCE_ENCRYPTION_KEY=
RFC3161_TSA_URL=https://freetsa.org/tsr

# ── App ───────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Configurable Limits ───────────────────────────
# Configurable maximum file size (default: 10GB = 10737418240 bytes)
ARGUS_MAX_FILE_SIZE_BYTES=10737418240
