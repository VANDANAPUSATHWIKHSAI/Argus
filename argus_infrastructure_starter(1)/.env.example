# Copy this file to .env and fill in locally -- .env itself is gitignored,
# so real credentials never get committed. This file (.env.example) is the
# one that goes in git, so everyone knows what variables they need.

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=argus_admin
MINIO_ROOT_PASSWORD=change_me_locally

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=argus
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=argus_fir

QDRANT_HOST=localhost
QDRANT_PORT=6333

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_locally
